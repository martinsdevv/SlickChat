# Template — copie UMA vez: cp deploy/.env.example deploy/.env
# Não rode `cp` de novo depois de configurar (isso apaga suas URLs).
# Para MinIO após o túnel: make demo-set-minio URL=https://....trycloudflare.com/storage

DEMO_PORT=3000

# Deixe vazio até subir o Cloudflare Tunnel; depois use make demo-set-minio
MINIO_PUBLIC_URL=

# Uploads passam pela API (obrigatório para celular / túnel). Só local direto ao MinIO:
# MINIO_UPLOAD_DIRECT=true

# Opcional (padrão = compose local)
# KAFKA_BROKERS=localhost:9092
# REDIS_ADDR=localhost:6379
# SLICKCHAT_API_URL=http://127.0.0.1:8081
